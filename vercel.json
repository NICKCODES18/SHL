{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pip install -r requirements-vercel.txt && python scripts/prebuild_tfidf.py",
  "installCommand": "pip install -r requirements-vercel.txt",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "env": {
    "VERCEL": "1"
  }
}
